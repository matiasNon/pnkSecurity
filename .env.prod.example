# AMBIENTE DE PRODUCCION: copiar a .env.prod y reemplazar TODOS los valores. .env.prod NUNCA se commitea.
# Generar secretos:  openssl rand -base64 48
APP_ENV=prod
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

POSTGRES_USER=pnk_app
POSTGRES_PASSWORD=CAMBIAR_clave_larga_y_aleatoria
POSTGRES_DB=pnk_carta

DB_HOST=db
DB_PORT=5432
DB_NAME=pnk_carta
DB_USER=pnk_app
DB_PASSWORD=CAMBIAR_misma_clave_que_POSTGRES_PASSWORD

# Minimo 32 caracteres aleatorios (la app no arranca con menos)
SESSION_SECRET=CAMBIAR_secreto_de_sesion_de_48_caracteres_o_mas

# IP publica del servidor (o dominio cuando exista)
PUBLIC_HOST=CAMBIAR_ip_o_dominio

# Claves iniciales de las cuentas (12+ caracteres). Sin ellas no se crean cuentas.
ADMIN_PASSWORD=CAMBIAR_clave_admin_larga
CLIENTE_PASSWORD=CAMBIAR_clave_cliente_larga
