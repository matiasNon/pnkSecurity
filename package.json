{
  "name": "pnk-carta-digital",
  "version": "1.0.0",
  "description": "Carta digital pnkSecurity: backend API REST (Node.js + Express + PostgreSQL) y frontend estatico (nginx) separados",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed-usuarios.js",
    "lint": "eslint src scripts tests frontend/public/js/app",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "deprecadas": "node scripts/revisar-deprecadas.js",
    "qa": "bash scripts/qa.sh"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/funcionales/**/*.test.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "testTimeout": 30000,
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}"
        }
      ],
      [
        "jest-html-reporter",
        {
          "pageTitle": "Pruebas funcionales - Carta digital PNK",
          "outputPath": "reports/informe-qa.html",
          "includeFailureMsg": true,
          "includeSuiteFailure": true
        }
      ]
    ]
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
