<%- include('../partials/cabecera') %>
<nav class="navbar navbar-light bg-light">
  <a class="btn btn-link" href="/admin/<%= nombreRecurso %>">&larr; <%= recurso.plural %></a>
</nav>
<section>
  <div class="container contendor">
    <h4 class="intro-title text-center"><%= titulo %></h4>
<% if (errores.general) { %>
    <div class="alert alert-danger" role="alert"><%= errores.general %></div>
<% } %>
    <form action="/admin/<%= nombreRecurso %><%= id ? '/' + id : '' %>" method="post"<%- recurso.multipart ? ' enctype="multipart/form-data"' : '' %>>
      <input type="hidden" name="csrf" value="<%= csrfToken %>">
<% for (const c of campos) { %>
<% const valor = valores[c.nombre]; const error = errores[c.nombre]; %>
<% if (c.tipo === 'checkbox') { %>
      <div class="form-group form-check">
        <input type="checkbox" class="form-check-input" id="f-<%= c.nombre %>" name="<%= c.nombre %>"<%- valor ? ' checked' : '' %>>
        <label class="form-check-label" for="f-<%= c.nombre %>"><%= c.etiqueta %></label>
      </div>
<% } else { %>
      <div class="form-group">
        <label for="f-<%= c.nombre %>"><%= c.etiqueta %><%= c.requerido ? ' *' : '' %></label>
<% if (c.tipo === 'select') { %>
        <select class="form-control" id="f-<%= c.nombre %>" name="<%= c.nombre %>"<%- c.requerido ? ' required' : '' %>>
          <option value="">Seleccione...</option>
<% for (const o of c.opciones) { %>
          <option value="<%= o.valor %>"<%- String(valor) === String(o.valor) ? ' selected' : '' %>><%= o.texto %></option>
<% } %>
        </select>
<% } else if (c.tipo === 'file') { %>
<% if (fotoActual) { %>
        <div><img src="<%= fotoActual %>" alt="" width="120px" class="mb-2"></div>
<% } %>
        <input type="file" class="form-control-file" id="f-<%= c.nombre %>" name="<%= c.nombre %>" accept="image/jpeg,image/png,image/gif,image/webp">
<% } else { %>
        <input type="<%= c.tipo %>" class="form-control" id="f-<%= c.nombre %>" name="<%= c.nombre %>" value="<%= valor ?? '' %>"
<% if (c.max !== undefined && c.tipo === 'text') { %> maxlength="<%= c.max %>"<% } %>
<% if (c.tipo === 'number') { %> min="<%= c.min %>" max="<%= c.max %>"<% } %>
<%- c.requerido ? ' required' : '' %>>
<% } %>
<% if (error) { %>
        <small class="text-danger" role="alert"><%= error %></small>
<% } %>
      </div>
<% } %>
<% } %>
      <button type="submit" class="btn btn-success">Guardar</button>
      <a class="btn btn-link" href="/admin/<%= nombreRecurso %>">Cancelar</a>
    </form>
  </div>
</section>
<%- include('../partials/pie') %>
<%- include('../partials/scripts') %>
