<%- include('../partials/cabecera') %>
<nav class="navbar navbar-light bg-light">
  <a class="btn btn-link" href="/admin">&larr; Panel</a>
  <a class="btn btn-outline-success" href="/admin/<%= nombreRecurso %>/nuevo">Nueva <%= recurso.singular.toLowerCase() %></a>
</nav>
<section>
  <div class="container contendor">
    <h4 class="intro-title text-center"><%= recurso.plural %></h4>
<% if (mensaje) { %>
    <div class="alert alert-success" role="alert"><%= mensaje %></div>
<% } %>
    <table class="table table-hover">
      <thead>
        <tr>
<% for (const col of recurso.columnas) { %>
          <th scope="col"><%= col.titulo %></th>
<% } %>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
<% if (filas.length === 0) { %>
        <tr><td colspan="<%= recurso.columnas.length + 1 %>" class="text-center">No hay registros.</td></tr>
<% } %>
<% for (const f of filas) { %>
        <tr>
<% for (const col of recurso.columnas) { %>
<% const v = f[col.campo]; %>
          <td><%= col.tipo === 'bool' ? (v ? 'Sí' : 'No') : (col.tipo === 'moneda' ? moneda(v) : (v ?? '')) %></td>
<% } %>
          <td>
            <a class="btn btn-sm btn-outline-primary" href="/admin/<%= nombreRecurso %>/<%= f.id %>/editar">Editar</a>
            <form class="d-inline" action="/admin/<%= nombreRecurso %>/<%= f.id %>/eliminar" method="post">
              <input type="hidden" name="csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
            </form>
          </td>
        </tr>
<% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include('../partials/pie') %>
<%- include('../partials/scripts') %>
