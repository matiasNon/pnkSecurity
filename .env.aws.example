# PRODUCCION EN AWS (RDS): el script de despliegue genera .env.aws en cada instancia. .env.aws NUNCA se commitea.
# Secretos: openssl rand -base64 48
DB_HOST=CAMBIAR_endpoint_de_rds.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=pnk_carta
DB_USER=pnk_app
DB_PASSWORD=CAMBIAR_clave_larga_y_aleatoria

# Minimo 32 caracteres aleatorios (la app no arranca con menos)
SESSION_SECRET=CAMBIAR_secreto_de_sesion_de_48_caracteres_o_mas

# Nombre DNS del balanceador (o el dominio de Cloudflare cuando exista)
PUBLIC_HOST=CAMBIAR_dns_del_alb_o_dominio
# 1 solo cuando el ALB/Cloudflare entregan HTTPS (si no, la app redirigiria a un HTTPS inexistente)
FORCE_HTTPS=0

# Claves iniciales de las cuentas (12+ caracteres). Solo se usan la primera vez (si la cuenta no existe).
ADMIN_PASSWORD=CAMBIAR_clave_admin_larga
CLIENTE_PASSWORD=CAMBIAR_clave_cliente_larga
